# 1. Keep your specific classes so R8 doesn't delete them
-keep class com.dg.fendai.implement.** { *; }
-keep class com.dg.fendai.core.** { *; }
-keep class com.dg.fendai.implement.RegisterFendAI { *; }

# 2. Keep the prompt annotations
-keep class com.dg.fendai.implement.Prompt { *; }
-keepclassmembers class * {
    @com.dg.fendai.implement.Prompt *;
}


# 3. IGNORE missing classes so the build finishes (Crucial for checking)
-dontwarn **
